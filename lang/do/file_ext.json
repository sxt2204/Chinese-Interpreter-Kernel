            ],
            "do": "file_ext.h"
        },
        "追加文件文本（{1}，{2}）": {
            "to": "do_append_file（{1}，{2}）",
            "type": "function",
            "params": [
                { "name": "{1}", "type": "string" },
                { "name": "{2}", "type": "string" }
            ],
            "do": "file_ext.h"
        },
        "文件是否存在（{1}）": {
            "to": "do_file_exists（{1}）",
            "type": "function",
            "params": [
                { "name": "{1}", "type": "string" }
            ],
            "do": "file_ext.h"
        }
    }
