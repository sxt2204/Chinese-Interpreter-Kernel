{
    "keywords": {
        "设置画笔颜色（{0}，{1}，{2}）": "opengl_set_color({0}, {1}, {2})",
        "绘制点（{0}，{1}）": "opengl_draw_point({0}, {1})",
        "绘制直线（{0}，{1}，{2}，{3}）": "opengl_draw_line({0}, {1}, {2}, {3})",
        "绘制矩形（{0}，{1}，{2}，{3}）": "opengl_draw_rect({0}, {1}, {2}, {3})",
        "显示绘图窗口（）": "opengl_show_window()"
    }
}
